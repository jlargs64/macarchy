#!/usr/bin/env bash
# Reject commit subjects that are not Conventional Commits. See CONTRIBUTING.md.
# Enable with: git config core.hooksPath .githooks
subject="$(head -n1 "$1")"
case "$subject" in "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;; esac
re='^(feat|fix|perf|refactor|docs|style|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'
if ! printf '%s' "$subject" | grep -qE "$re"; then
  echo "commit-msg: not a Conventional Commit: $subject" >&2
  echo "  expected e.g. fix(ws): refresh the bar after moves   (see CONTRIBUTING.md)" >&2
  exit 1
fi
