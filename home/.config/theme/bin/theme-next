#!/usr/bin/env bash
# theme-next — switch to the next theme alphabetically, wrapping around.
set -euo pipefail
THEME_ROOT="$HOME/.config/theme"

themes=()
while IFS= read -r t; do
  themes+=("$t")
done < <("$THEME_ROOT/bin/theme-list")
[ "${#themes[@]}" -gt 0 ] || {
  echo "theme-next: no themes" >&2
  exit 1
}

cur=""
link="$(readlink "$THEME_ROOT/current" 2>/dev/null || true)"
[ -n "$link" ] && cur="$(basename "$link")"

next="${themes[0]}"
i=0
while [ "$i" -lt "${#themes[@]}" ]; do
  if [ "${themes[$i]}" = "$cur" ]; then
    next="${themes[$(((i + 1) % ${#themes[@]}))]}"
    break
  fi
  i=$((i + 1))
done
exec "$THEME_ROOT/bin/theme-set" "$next"
