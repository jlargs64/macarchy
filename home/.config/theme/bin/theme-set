#!/usr/bin/env bash
# theme-set <name> — point ~/.config/theme/current at a theme and reload everything live.
set -euo pipefail

THEME_ROOT="$HOME/.config/theme"
THEMES_DIR="$THEME_ROOT/themes"
CURRENT="$THEME_ROOT/current"
name="${1:-}"

if [ -z "$name" ]; then
  echo "usage: theme-set <name>" >&2
  echo "themes:" >&2
  "$THEME_ROOT/bin/theme-list" | sed 's/^/  /' >&2
  exit 2
fi

# A theme is a plain directory name. Anything path-like would pass the -d
# check below and then get `source`d, so refuse it outright.
case "$name" in
  */* | .* | *[[:space:]]*)
    echo "theme-set: invalid theme name: $name" >&2
    exit 1
    ;;
esac

if [ ! -d "$THEMES_DIR/$name" ]; then
  echo "theme-set: no such theme: $name" >&2
  echo "themes:" >&2
  "$THEME_ROOT/bin/theme-list" | sed 's/^/  /' >&2
  exit 1
fi

# 1. THE symlink
ln -sfn "$THEMES_DIR/$name" "$CURRENT"

# shellcheck disable=SC1091
source "$CURRENT/colors.sh"
# shellcheck disable=SC1091
if [ -f "$HOME/.config/macarchy/lib.sh" ]; then . "$HOME/.config/macarchy/lib.sh" || true; fi

# 2. Hooks: one script per app under $THEME_ROOT/hooks/. Each one checks that
# its app is installed and exits quietly if not, so "auto" runs them all.
# MACARCHY_THEME_TARGETS narrows the list (e.g. "ghostty neovim wallpaper").
# Scripts in ~/.config/macarchy/hooks.d/ are yours and always run, after ours.
# Hooks get the palette (colors.sh) plus THEME_NAME, THEME_DIR, THEME_ROOT and
# THEME_OUT, where generated files for include-style apps live.
export THEME_ROOT THEME_DIR="$THEMES_DIR/$name" THEME_OUT="$THEME_ROOT/generated"
mkdir -p "$THEME_OUT"

targets="${MACARCHY_THEME_TARGETS:-auto}"
if [ "$targets" = auto ]; then
  targets=""
  for h in "$THEME_ROOT"/hooks/*; do targets="$targets ${h##*/}"; done
fi

run_hook() {
  [ -x "$1" ] || return 0
  "$1" "$THEME_DIR" || echo "theme-set: hook ${1##*/} failed (exit $?)" >&2
}
for t in $targets; do
  if [ -e "$THEME_ROOT/hooks/$t" ]; then
    run_hook "$THEME_ROOT/hooks/$t"
  else
    echo "theme-set: no hook named '$t' (MACARCHY_THEME_TARGETS)" >&2
  fi
done
for h in "$HOME"/.config/macarchy/hooks.d/*; do
  run_hook "$h"
done

echo "theme: $name"
