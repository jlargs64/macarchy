#!/usr/bin/env bash
# theme-new -- make your own theme from a palette.
#
# Usage:
#   theme-new <name> [--from THEME] [--out DIR]   create a theme
#   theme-new --regen <name> [--out DIR]          rebuild it after editing colors.sh
#
# A new theme starts as a copy of another theme's colors.sh (--from, default
# the active theme), renamed. Every other file is generated from that one
# palette: ghostty (16-slot ANSI, same darken-for-dim rule as theme-port),
# zellij.kdl, borders, and a Neovim colorscheme that drives mini.base16
# (neovim.lua plus nvim-<name>/colors/<name>.lua, the pattern hollow
# uses). kitty, Alacritty, iTerm2, Zed and the wallpaper already come
# from colors.sh via theme-render and theme-wallpaper.
#
# The loop: theme-new mine; edit colors.sh; theme-new --regen mine;
# theme-set mine. --regen only rewrites files that carry theme-new's header,
# so a file you took over by hand (delete the header line) is left alone.
#
# --out defaults to ~/.config/theme/themes, where your own themes live. Point
# it at a checkout's home/.config/theme/themes to add a theme to macarchy.
#
# Written for bash 3.2 (macOS system bash): no mapfile, no associative arrays.
set -euo pipefail

THEME_ROOT="$HOME/.config/theme"
MARK="generated by theme-new"

usage() {
  cat >&2 <<'EOF'
usage: theme-new <name> [--from THEME] [--out DIR]
       theme-new --regen <name> [--out DIR]

  <name>        letters, digits, - and _ (becomes the directory and the
                Neovim colorscheme name)
  --from THEME  copy this theme's colors.sh as the starting palette
                (default: the active theme)
  --out DIR     themes directory to write into (default: ~/.config/theme/themes)
  --regen       rebuild ghostty, zellij.kdl, borders and the Neovim files
                from <name>'s colors.sh
EOF
  exit 2
}

NAME="" FROM="" OUT="" REGEN=0
while [ $# -gt 0 ]; do
  case "$1" in
    --from)
      FROM="${2:-}"
      shift 2 || usage
      ;;
    --out)
      OUT="${2:-}"
      shift 2 || usage
      ;;
    --regen)
      REGEN=1
      shift
      ;;
    -h | --help) usage ;;
    -*)
      echo "theme-new: unknown flag: $1" >&2
      usage
      ;;
    *)
      [ -z "$NAME" ] || {
        echo "theme-new: unexpected argument: $1" >&2
        usage
      }
      NAME="$1"
      shift
      ;;
  esac
done

[ -n "$NAME" ] || usage
case "$NAME" in
  [A-Za-z0-9]*) ;;
  *)
    echo "theme-new: a theme name starts with a letter or digit: $NAME" >&2
    exit 1
    ;;
esac
case "$NAME" in
  *[!A-Za-z0-9_-]*)
    echo "theme-new: a theme name is letters, digits, - and _ only: $NAME" >&2
    exit 1
    ;;
esac

OUT="${OUT:-$THEME_ROOT/themes}"
OUT="${OUT%/}"
DEST="$OUT/$NAME"

# --- create: seed colors.sh ---------------------------------------------
if [ "$REGEN" = 0 ]; then
  if [ -e "$DEST" ]; then
    echo "theme-new: $DEST already exists (use --regen to rebuild it from its colors.sh)" >&2
    exit 1
  fi
  if [ -n "$FROM" ]; then
    case "$FROM" in
      */* | .*)
        echo "theme-new: --from takes a theme name, not a path: $FROM" >&2
        exit 1
        ;;
    esac
    src="$OUT/$FROM"
    [ -f "$src/colors.sh" ] || src="$THEME_ROOT/themes/$FROM"
  else
    src="$THEME_ROOT/current"
    FROM="$(basename "$(readlink "$src" 2>/dev/null || echo "")")"
  fi
  if [ ! -f "$src/colors.sh" ]; then
    echo "theme-new: no colors.sh to start from at $src (pass --from THEME)" >&2
    exit 1
  fi
  mkdir -p "$DEST"
  {
    echo "# $NAME palette (bare hex: no # and no 0x). Started from ${FROM:-another theme}."
    echo "# Edit these, then run: theme-new --regen $NAME && theme-set $NAME"
    # Keep the palette values, drop the source's comments and identity.
    grep -E '^export (BG|FG|ACCENT|ACCENT2|MUTED|RED|GREEN|YELLOW|BLUE|MAGENTA|CYAN)=' "$src/colors.sh"
  } >"$DEST/colors.sh.tmp"
  {
    sed -n '1,2p' "$DEST/colors.sh.tmp"
    echo "export THEME_NAME=$NAME"
    echo "export NVIM_COLORSCHEME=$NAME"
    sed '1,2d' "$DEST/colors.sh.tmp"
  } >"$DEST/colors.sh"
  rm -f "$DEST/colors.sh.tmp"
elif [ ! -f "$DEST/colors.sh" ]; then
  echo "theme-new: no theme at $DEST (run theme-new $NAME first)" >&2
  exit 1
fi

# --- validate the palette -------------------------------------------------
# Read it in a subshell so a broken colors.sh can't clobber our variables.
palette="$(bash -c '. "$1" >/dev/null || exit 1
  for k in BG FG ACCENT ACCENT2 MUTED RED GREEN YELLOW BLUE MAGENTA CYAN; do
    eval "printf \"%s=%s\n\" $k \"\${$k:-}\""
  done' _ "$DEST/colors.sh")" || {
  echo "theme-new: $DEST/colors.sh failed to load" >&2
  exit 1
}
bad=""
while IFS='=' read -r k v; do
  case "$v" in
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) eval "$k=\$(printf %s \"\$v\" | tr A-F a-f)" ;;
    *) bad="$bad $k=${v:-(unset)}" ;;
  esac
done <<EOF
$palette
EOF
if [ -n "$bad" ]; then
  echo "theme-new: $DEST/colors.sh needs 6-digit bare hex (no #, no 0x) for:$bad" >&2
  exit 1
fi

# --- colour arithmetic ----------------------------------------------------
# mix <a> <b> <pct> -> a moved pct% of the way to b, per channel, rounded.
mix() {
  local a="$1" b="$2" p="$3" i out="" x y
  for i in 0 2 4; do
    x=$((16#${a:i:2}))
    y=$((16#${b:i:2}))
    out="$out$(printf '%02x' $(((x * (100 - p) + y * p + 50) / 100)))"
  done
  printf '%s' "$out"
}
darken15() { mix "$1" 000000 15; }

luma=$(((16#${BG:0:2} * 299 + 16#${BG:2:2} * 587 + 16#${BG:4:2} * 114) / 1000))
if [ "$luma" -gt 127 ]; then MODE=light FAR=000000; else MODE=dark FAR=ffffff; fi

# base16 from the 11-colour contract. 00-07 is a ramp from BG to FG and
# beyond it, away from the background; 08-0F are the hues.
B00="$BG"
B01="$(mix "$BG" "$FG" 6)"
B02="$(mix "$BG" "$FG" 15)"
B03="$MUTED"
B04="$(mix "$MUTED" "$FG" 50)"
B05="$FG"
B06="$(mix "$FG" "$FAR" 30)"
B07="$(mix "$FG" "$FAR" 60)"
B0F="$(mix "$RED" "$BG" 35)"

# write <file>: stdin to DEST/<file>, unless it exists without our header
# (someone took it over by hand).
write() {
  local f="$DEST/$1"
  if [ -f "$f" ] && ! head -n 3 "$f" | grep -q "$MARK"; then
    echo "  kept    $1 (hand-edited: no \"$MARK\" header)"
    cat >/dev/null
    return 0
  fi
  mkdir -p "$(dirname "$f")"
  cat >"$f"
  echo "  wrote   $1"
}

echo "theme-new: $DEST ($MODE)"
[ "$REGEN" = 1 ] || echo "  wrote   colors.sh"

write ghostty <<EOF
# $NAME -- $MARK from colors.sh; edit colors.sh, then theme-new --regen $NAME
background = $BG
foreground = $FG
cursor-color = $ACCENT
cursor-text = $BG
selection-background = $B02
selection-foreground = $FG

# 0-7 dim (RED/GREEN/YELLOW/BLUE/MAGENTA/CYAN/FG darkened 15%, BG verbatim),
# 8-15 bright (MUTED, then canonical RED..CYAN, then FG)
palette = 0=#$BG
palette = 1=#$(darken15 "$RED")
palette = 2=#$(darken15 "$GREEN")
palette = 3=#$(darken15 "$YELLOW")
palette = 4=#$(darken15 "$BLUE")
palette = 5=#$(darken15 "$MAGENTA")
palette = 6=#$(darken15 "$CYAN")
palette = 7=#$(darken15 "$FG")
palette = 8=#$MUTED
palette = 9=#$RED
palette = 10=#$GREEN
palette = 11=#$YELLOW
palette = 12=#$BLUE
palette = 13=#$MAGENTA
palette = 14=#$CYAN
palette = 15=#$FG
EOF

write zellij.kdl <<EOF
// $NAME -- $MARK from colors.sh
themes {
    current {
        fg "#$FG"
        bg "#$BG"
        black "#$BG"
        red "#$RED"
        green "#$GREEN"
        yellow "#$YELLOW"
        blue "#$BLUE"
        magenta "#$MAGENTA"
        cyan "#$CYAN"
        white "#$FG"
        orange "#$ACCENT"
    }
}
EOF

write borders <<'EOF'
# generated by theme-new (the same for every theme: it reads colors.sh)
source "$HOME/.config/theme/current/colors.sh"
active_color=0xff${ACCENT}
EOF

write neovim.lua <<EOF
-- $NAME -- $MARK (local plugin driving mini.base16)
return {
  { "nvim-mini/mini.base16", version = false, lazy = false, priority = 1001 },
  {
    dir = vim.fn.expand("~/.config/theme/themes/$NAME/nvim-$NAME"),
    name = "$NAME",
    lazy = false,
    priority = 1000,
    dependencies = { "nvim-mini/mini.base16" },
  },
  { "LazyVim/LazyVim", opts = { colorscheme = "$NAME" } },
}
EOF

write "nvim-$NAME/colors/$NAME.lua" <<EOF
-- $NAME colorscheme -- $MARK from colors.sh
local ok, base16 = pcall(require, "mini.base16")
if not ok then
  vim.notify("$NAME: mini.base16 not available", vim.log.levels.ERROR)
  return
end

vim.o.background = "$MODE"
base16.setup({
  palette = {
    base00 = "#$B00", -- background
    base01 = "#$B01", -- lighter background
    base02 = "#$B02", -- selection
    base03 = "#$B03", -- comments (MUTED)
    base04 = "#$B04", -- dark foreground
    base05 = "#$B05", -- foreground
    base06 = "#$B06", -- light foreground
    base07 = "#$B07", -- brightest foreground
    base08 = "#$RED", -- red
    base09 = "#$ACCENT", -- accent
    base0A = "#$YELLOW", -- yellow
    base0B = "#$GREEN", -- green
    base0C = "#$CYAN", -- cyan
    base0D = "#$BLUE", -- blue
    base0E = "#$MAGENTA", -- magenta
    base0F = "#$B0F", -- brown
  },
  use_cterm = false,
})

vim.g.colors_name = "$NAME"
EOF

if [ "$MODE" = light ]; then
  echo "  note: light background. The bar and border colours assume a dark one; check them after theme-set."
fi
if [ "$REGEN" = 0 ]; then
  cat <<EOF

Next:
  1. edit   $DEST/colors.sh
  2. run    theme-new --regen $NAME
  3. run    theme-set $NAME
EOF
fi
