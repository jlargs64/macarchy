#!/usr/bin/env bash
# theme-list — print available theme names, alphabetically.
set -euo pipefail
THEMES_DIR="$HOME/.config/theme/themes"
[ -d "$THEMES_DIR" ] || {
  echo "no themes dir: $THEMES_DIR" >&2
  exit 1
}
# Only directories with a colors.sh: a renamed theme's old directory keeps its
# runtime files (backgrounds/, wallpaper.jpg) but is no longer a theme.
for d in "$THEMES_DIR"/*/; do
  if [ -f "$d/colors.sh" ]; then basename "$d"; fi
done | LC_ALL=C sort
