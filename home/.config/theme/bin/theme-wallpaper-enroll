#!/usr/bin/env bash
# theme-wallpaper-enroll -- point EVERY macOS Space at the shared wallpaper file.
#
# Why this exists: macOS stores the wallpaper per Space, and AppleScript can
# only reach the Space that is currently active (System Events exposes one
# "desktop" per DISPLAY, not per Space). yabai cannot switch Spaces either
# without the scripting addition, which this setup does not use.
#
# So this walks the Spaces using the native ctrl+<number> shortcut, sets the
# wallpaper on each, and returns to where you started. After that every Space
# points at ~/.config/theme/wallpaper-current.jpg and `theme-set` only has to
# rewrite that file. Your screen will visibly flick through each Space.
#
#   theme-wallpaper-enroll          walk every Space now (needs ctrl+<number>)
#   theme-wallpaper-enroll --here   enroll only the Spaces on screen right now,
#                                   quietly and without switching. yabairc runs
#                                   this on every Space switch, so a Space you
#                                   added (or a new display) picks up the theme
#                                   the first time you land on it.
set -euo pipefail

THEME_ROOT="$HOME/.config/theme"
FIXED="$THEME_ROOT/wallpaper-current.jpg"
# shellcheck source=../lib/wallpaper.sh
. "$THEME_ROOT/lib/wallpaper.sh"

[ -L "$THEME_ROOT/current" ] || {
  echo "no theme selected; run theme-set first" >&2
  exit 1
}

if [ "${1:-}" = --here ]; then
  # The file already holds the current wallpaper (theme-set and theme-bg keep
  # it fresh); only point the visible desktops at it if they aren't already.
  [ -f "$FIXED" ] || exit 0
  osascript >/dev/null 2>&1 <<EOS || true
tell application "System Events"
  repeat with d in desktops
    if picture of d is not "$FIXED" then set picture of d to "$FIXED"
  end repeat
end tell
EOS
  exit 0
fi

# Seed the shared file with what the theme shows now (the background chosen
# with theme-bg, not the gradient), so enrolling never resets that choice.
src="$(theme_wallpaper_for "$THEME_ROOT/current")" || {
  echo "the current theme has no wallpaper yet; run theme-set first" >&2
  exit 1
}
cp -f "$src" "$FIXED"

if ! command -v yabai >/dev/null 2>&1; then
  echo "theme-wallpaper-enroll: needs yabai to enumerate Spaces" >&2
  exit 1
fi

count=$(yabai -m query --spaces 2>/dev/null | jq 'length')
start=$(yabai -m query --spaces 2>/dev/null | jq -r '.[] | select(."has-focus") | .index')
[ -z "$count" ] && {
  echo "could not query Spaces" >&2
  exit 1
}
[ "$count" -gt 9 ] && count=9

# macOS key codes for the digits 1..9
codes=(18 19 20 21 23 22 26 28 25)

goto() {
  osascript -e "tell application \"System Events\" to key code ${codes[$(($1 - 1))]} using control down" >/dev/null 2>&1 || true
  sleep 0.6
}
setwp() {
  osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$FIXED\"" >/dev/null 2>&1 || true
}

echo "enrolling $count Space(s)..."
i=1
while [ "$i" -le "$count" ]; do
  goto "$i"
  setwp
  echo "  Space $i"
  i=$((i + 1))
done

[ -n "$start" ] && goto "$start"
theme_wallpaper_push "$FIXED" # Spaces that already pointed at the file only repaint on restart
echo "done. every Space now follows theme-set."
echo "note: ctrl+<number> must be enabled in System Settings > Keyboard >"
echo "      Keyboard Shortcuts > Mission Control for this to work."
