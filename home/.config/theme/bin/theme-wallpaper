#!/usr/bin/env bash
# theme-wallpaper <theme-dir> — generate wallpaper.jpg from the theme palette if missing.
# Uses ImageMagick when available, otherwise Python/Pillow, otherwise a solid sips fill.
set -euo pipefail
dir="${1:?usage: theme-wallpaper <theme-dir>}"
out="$dir/wallpaper.jpg"
[ -f "$out" ] && exit 0
# shellcheck disable=SC1091
source "$dir/colors.sh"

case "$THEME_NAME" in
  retro-82)
    TOP=0b0a0f
    BOT=221c2e
    SCAN=1
    ;;
  kanagawa-wave)
    TOP=1f1f28
    BOT=2a2a3c
    SCAN=0
    ;;
  catppuccin-mocha)
    TOP=1e1e2e
    BOT=302d45
    SCAN=0
    ;;
  *)
    TOP="$BG"
    BOT="$MUTED"
    SCAN=0
    ;;
esac

W=5120
H=2880
png="$(mktemp -t wallpaper).png"

if command -v magick >/dev/null 2>&1; then
  if [ "$SCAN" = 1 ]; then
    # Vertical gradient, then darken every 4th row to fake CRT scanlines:
    # build a 4-row tile whose first row is 35% black and the rest transparent,
    # tile it to full size, and composite it over the gradient.
    magick -size ${W}x${H} "gradient:#${TOP}-#${BOT}" \
      \( -size ${W}x4 xc:none -fill "rgba(0,0,0,0.35)" \
      -draw "rectangle 0,0 ${W},0" -write mpr:sl +delete \) \
      \( -size ${W}x${H} tile:mpr:sl \) \
      -compose over -composite "$png"
  else
    magick -size ${W}x${H} "gradient:#${TOP}-#${BOT}" "$png"
  fi
elif python3 -c 'import PIL' >/dev/null 2>&1; then
  TOP="$TOP" BOT="$BOT" SCAN="$SCAN" W="$W" H="$H" PNG="$png" python3 <<'PY'
import os
from PIL import Image
w, h = int(os.environ["W"]), int(os.environ["H"])
top = tuple(int(os.environ["TOP"][i:i+2], 16) for i in (0, 2, 4))
bot = tuple(int(os.environ["BOT"][i:i+2], 16) for i in (0, 2, 4))
scan = os.environ["SCAN"] == "1"
col = Image.new("RGB", (1, h))
px = col.load()
for y in range(h):
    t = y / (h - 1)
    px[0, y] = tuple(round(top[c] + (bot[c] - top[c]) * t) for c in range(3))
if scan:
    for y in range(0, h, 4):
        r, g, b = px[0, y]
        px[0, y] = (max(0, r - 6), max(0, g - 6), max(0, b - 6))
col.resize((w, h), Image.NEAREST).save(os.environ["PNG"])
PY
else
  # last resort: solid background via sips
  python3 - "$png" "$TOP" "$W" "$H" <<'PY' 2>/dev/null || {
import sys, struct, zlib
png, top, w, h = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
rgb = bytes(int(top[i:i+2], 16) for i in (0, 2, 4))
raw = b"".join(b"\x00" + rgb * w for _ in range(h))
def chunk(t, d):
    c = t + d
    return struct.pack(">I", len(d)) + c + struct.pack(">I", zlib.crc32(c))
open(png, "wb").write(
    b"\x89PNG\r\n\x1a\n"
    + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
    + chunk(b"IDAT", zlib.compress(raw, 6))
    + chunk(b"IEND", b"")
)
PY
    echo "theme-wallpaper: no image backend" >&2
    exit 1
  }
fi

sips -s format jpeg -s formatOptions 85 "$png" --out "$out" >/dev/null
rm -f "$png"
echo "wallpaper: $out"
