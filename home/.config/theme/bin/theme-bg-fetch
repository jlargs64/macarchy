#!/usr/bin/env bash
# theme-bg-fetch -- download each theme's backgrounds from upstream Omarchy
# and convert them to JPEG in themes/<name>/backgrounds/.
#
# Backgrounds are NOT committed to this repo (~15 MB of binaries); they are
# fetched on demand, by `install.sh` and by `theme-maintain`. Re-running is
# cheap: a file that already exists is skipped.
#
# Every theme gets exactly Omarchy's own backgrounds, in Omarchy's order,
# minus the Omarchy-logo `omarchy.webp` each one carries.
set -euo pipefail

THEMES="$HOME/.config/theme/themes"

# Pinned to a commit, not a branch. These bytes go straight into ImageMagick,
# so a moving ref would let any upstream commit choose what gets decoded here.
# Bump deliberately: git ls-remote https://github.com/omacom/omarchy quattro
#
# Omarchy moved from github.com/basecamp/omarchy to github.com/omacom/omarchy
# (branch `quattro`); this pin was verified against a local clone of that
# branch at this exact commit.
OMARCHY_OWNER="omacom/omarchy"
OMARCHY_REV="387fcf599a9d4afb403462e5a45b9f38ead0abd3"
OMARCHY_FALLBACK_REF="quattro"
RAW="https://raw.githubusercontent.com/$OMARCHY_OWNER/$OMARCHY_REV/themes"
RAW_FALLBACK="https://raw.githubusercontent.com/$OMARCHY_OWNER/$OMARCHY_FALLBACK_REF/themes"

command -v magick >/dev/null 2>&1 || {
  echo "theme-bg-fetch: needs imagemagick" >&2
  exit 1
}

# "<local theme>|<n>|<upstream theme>/<file>|<local name>"
MAP="
retro-82|01|retro-82/1-in-the-groove.webp|in-the-groove
retro-82|02|retro-82/2-dusk-guardian.webp|dusk-guardian
retro-82|03|retro-82/3-glassy-lines.webp|glassy-lines
retro-82|04|retro-82/4-gateway.webp|gateway
retro-82|05|retro-82/5-zen-boat.webp|zen-boat
retro-82|06|retro-82/6-abstract-pyramids.webp|abstract-pyramids
retro-82|07|retro-82/7-the-journey.webp|the-journey
retro-82|08|retro-82/8-glitter-glass.webp|glitter-glass
kanagawa|01|kanagawa/1-kanagawa.jpg|kanagawa
catppuccin|01|catppuccin/1-totoro.webp|totoro
catppuccin|02|catppuccin/2-waves.webp|waves
catppuccin|03|catppuccin/3-blue-eye.webp|blue-eye
catppuccin-latte|01|catppuccin-latte/1-color-fade.webp|color-fade
ethereal|01|ethereal/1-cosmic.webp|cosmic
ethereal|02|ethereal/2-meadow.webp|meadow
everforest|01|everforest/1-tree-tops.webp|tree-tops
flexoki-light|01|flexoki-light/1-orb.webp|orb
gruvbox|01|gruvbox/1-the-backwater.jpg|the-backwater
gruvbox|02|gruvbox/2-flower-basket.webp|flower-basket
gruvbox|03|gruvbox/3-village-square.jpg|village-square
gruvbox|04|gruvbox/4-idyllic-procession.jpg|idyllic-procession
gruvbox|05|gruvbox/5-leaves.jpg|leaves
hackerman|01|hackerman/1-synth-scape.jpg|synth-scape
hackerman|02|hackerman/2-geometric.webp|geometric
last-horizon|01|last-horizon/1-eyes-wide.webp|eyes-wide
last-horizon|02|last-horizon/2-blink.webp|blink
last-horizon|03|last-horizon/3-bokeh.webp|bokeh
last-horizon|04|last-horizon/4-new-horizons.jpg|new-horizons
lumon|01|lumon/01-united-in-severance.webp|united-in-severance
lumon|02|lumon/02-opinions-equally.webp|opinions-equally
lupine|01|lupine/01-cherry-blossom-bokeh.webp|cherry-blossom-bokeh
lupine|02|lupine/02-cherry-blossom-white.webp|cherry-blossom-white
lupine|03|lupine/03-pastel-clouds.webp|pastel-clouds
lupine|04|lupine/04-elegant-blue-wave.webp|elegant-blue-wave
lupine|05|lupine/05-abstract-wave.webp|abstract-wave
matte-black|01|matte-black/0-ship-at-sea.jpg|ship-at-sea
matte-black|02|matte-black/1-dark-waters.webp|dark-waters
matte-black|03|matte-black/2-dot-hands.webp|dot-hands
miasma|01|miasma/01-nature-of-fear.webp|nature-of-fear
miasma|02|miasma/02-crowned.webp|crowned
nord|01|nord/0-black-moon.jpg|black-moon
nord|02|nord/1-city-view.webp|city-view
nord|03|nord/2-night-hawks.webp|night-hawks
osaka-jade|01|osaka-jade/1-glowing-city.webp|glowing-city
osaka-jade|02|osaka-jade/2-shaded-entrance.webp|shaded-entrance
osaka-jade|03|osaka-jade/3-mountain-moon.webp|mountain-moon
ristretto|01|ristretto/0-launch.webp|launch
ristretto|02|ristretto/1-color-curves.webp|color-curves
ristretto|03|ristretto/2-coffee-beans.jpg|coffee-beans
ristretto|04|ristretto/3-industrial-moon.webp|industrial-moon
rose-pine|01|rose-pine/1-funky-shapes.webp|funky-shapes
rose-pine|02|rose-pine/2-dot-map.webp|dot-map
rose-pine|03|rose-pine/3-omarchy-plants.webp|omarchy-plants
solitude|01|solitude/1-on-pole.webp|on-pole
solitude|02|solitude/2-wreakage.webp|wreakage
solitude|03|solitude/3-climb.jpg|climb
solitude|04|solitude/4-ether.webp|ether
solitude|05|solitude/5-eyed.jpg|eyed
tokyo-night|01|tokyo-night/0-winding-road.webp|winding-road
tokyo-night|02|tokyo-night/1-quattro.webp|quattro
tokyo-night|03|tokyo-night/2-swirl-buck.webp|swirl-buck
tokyo-night|04|tokyo-night/3-sunset-lake.webp|sunset-lake
tokyo-night|05|tokyo-night/4-omakub.webp|omakub
tokyo-night|06|tokyo-night/5-oma-cityscape.jpg|oma-cityscape
tokyo-night|07|tokyo-night/6-oma.webp|oma
vantablack|01|vantablack/0-dot-hands.webp|dot-hands
vantablack|02|vantablack/1-twisted-stairs.webp|twisted-stairs
vantablack|03|vantablack/2-layers-deep.webp|layers-deep
vantablack|04|vantablack/3-layers-stacked.webp|layers-stacked
white|01|white/1-white.webp|white
white|02|white/2-white.webp|white
white|03|white/3-white.webp|white
"

# retro-82 used to lead with tokyo-night's quattro, which pushed its own set to
# 02-09. Remove those names so an upgrade does not show every image twice.
for f in 01-quattro 02-in-the-groove 03-dusk-guardian 04-glassy-lines 05-gateway \
  06-zen-boat 07-abstract-pyramids 08-the-journey 09-glitter-glass; do
  rm -f "$THEMES/retro-82/backgrounds/$f.jpg"
done

# One private scratch dir for every download; mktemp owns the name, we own
# the files inside it, and the trap removes all of it on any exit.
tmpdir="$(mktemp -d -t theme-bg)"
trap 'rm -rf "$tmpdir"' EXIT

echo "$MAP" | while IFS='|' read -r theme n src label; do
  [ -z "$theme" ] && continue
  [ -d "$THEMES/$theme" ] || continue
  mkdir -p "$THEMES/$theme/backgrounds"
  out="$THEMES/$theme/backgrounds/$n-$label.jpg"
  [ -f "$out" ] && continue
  tmp="$tmpdir/$theme-$n.${src##*.}"
  # $src is "<upstream theme>/<file>"; the real path has /backgrounds/ between them
  path="${src%%/*}/backgrounds/${src#*/}"
  url="$RAW/$path"
  # The pinned commit is the source of truth; only fall back to the moving
  # `quattro` branch ref if that exact commit's file is unreachable (e.g. a
  # history rewrite upstream).
  if ! curl -fsSL --max-time 120 -o "$tmp" "$url"; then
    url="$RAW_FALLBACK/$path"
    curl -fsSL --max-time 120 -o "$tmp" "$url" || true
  fi
  if [ -s "$tmp" ]; then
    # Omarchy ships these at 5120x2880 already; cover-fit anything that is not.
    magick "$tmp" -resize 5120x2880^ -gravity center -extent 5120x2880 \
      -quality 88 "$out" 2>/dev/null && echo "  $theme/$n-$label.jpg"
  else
    echo "  FAILED $url" >&2
  fi
  rm -f "$tmp"
done
echo "backgrounds ready"
