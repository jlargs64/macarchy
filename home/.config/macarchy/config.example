# macarchy config — copy to ~/.config/macarchy/config and edit.
# install.sh does this automatically if the target file does not exist yet.
#
# Every value below is the built-in default; ~/.config/macarchy/lib.sh sets
# these first, then sources ~/.config/macarchy/config over them if it exists.
# Delete any line you don't want to override -- lib.sh's own default takes
# over once it's gone.

# Theme selected on first install and by `theme-set` with no argument.
# One of the names under ~/.config/theme/themes/.
MACARCHY_DEFAULT_THEME=retro-82

# Apps theme-set restyles. "auto" runs every hook in ~/.config/theme/hooks/
# and each one skips an app you don't have installed. Or list just the ones
# you want: ghostty kitty alacritty iterm2 zellij neovim vscode zed
# sketchybar borders wallpaper. Your own scripts in
# ~/.config/macarchy/hooks.d/ always run too.
MACARCHY_THEME_TARGETS=auto

# Terminal the floating popups (theme-pick, macarchy-keys) open in.
# One of: ghostty kitty alacritty iterm2 wezterm
MACARCHY_TERMINAL=ghostty

# Which parts of macarchy install.sh and macarchy-update manage, from:
# themes wm bar borders keys agent. install.sh writes this line for you (it
# asks on the first run); leave it unset to mean all of them.
# MACARCHY_COMPONENTS="themes wm bar borders keys agent"

# Font used by sketchybarrc and the space.sh plugin. Must be installed and
# resolvable by SketchyBar as "<font>:<style>:<size>".
MACARCHY_FONT="Hack Nerd Font"

# Number of Spaces sketchybarrc renders indicators for (1-9; macOS control-N
# switching and the sketchybar-app-font key-code table only cover up to 9).
MACARCHY_SPACES=5

# Author line emitted in generated Raycast script commands
# (@raycast.author). Left blank, no author line is emitted at all.
MACARCHY_RAYCAST_AUTHOR=""

# Network interface the wifi plugin reads SSID/IP from. `en0` is the primary
# Wi-Fi interface on nearly all Macs; check `networksetup -listallhardwareports`
# if yours differs.
MACARCHY_WIFI_IFACE=en0

# true: install.sh sets up a LaunchAgent that runs `macarchy-update` at every
# login (fast-forward pull, relink, reload; log in
# ~/Library/Logs/macarchy-update.log). Toggle later with
# `macarchy-update --login on|off`.
MACARCHY_UPDATE_AT_LOGIN=true

# Hotkey sources macarchy-keys shows in its which-key picker, space-separated.
# One or more of: skhd ghostty zellij. Override per invocation with
# `macarchy-keys --source <name>`. A listed source whose config file doesn't
# exist (e.g. no Ghostty installed) is skipped silently.
MACARCHY_KEYS_SOURCES="skhd ghostty zellij"

# --- workspace agent (ws) ---
MACARCHY_AGENT_MODEL="$HOME/.local/share/macarchy/models/workspace-agent.cact"   # fine-tuned Needle 3
MACARCHY_AGENT_EXECUTE=false      # true: `ws` and `ws --voice` act instead of printing what they would do
MACARCHY_MIC=":default"           # mic for `ws --voice`: the system default input. To pin one, use its avfoundation
                                  # index, e.g. ":1" (ffmpeg -f avfoundation -list_devices true -i ""). Virtual devices
                                  # such as BlackHole often sit at :0 and record silence.
# Installed by install.sh (brew cask `handy`, https://handy.computer). Handy's
# own dictation hotkey is alt-space (hold to talk, tap to toggle) -- that is
# configured inside Handy itself, not skhd; see skhdrc for why.
MACARCHY_HANDY="/Applications/Handy.app/Contents/MacOS/handy"
