#!/usr/bin/env bash
# macarchy-update — pull the latest macarchy and bring $HOME in line with it.
#
# Usage:
#   macarchy-update             pull, relink, reload whatever changed
#   macarchy-update --no-pull   skip the pull; just relink and reload everything
#   macarchy-update --login on  run automatically at every login (LaunchAgent)
#   macarchy-update --login off stop running at login
#
# 1. git pull --ff-only in the repo this script lives in (refuses to merge or
#    clobber local edits; commit or stash them first)
# 2. symlinks every git-tracked file under home/ into $HOME, the same way
#    install.sh's step_link does, so files added upstream show up. Only files
#    of the components you installed (MACARCHY_COMPONENTS) are linked
# 3. removes symlinks in $HOME that point at repo files deleted upstream
# 4. reloads only the services whose config changed in the pull
#
# Edits to files that were already linked are live the moment git pulls them;
# steps 2-4 cover what a bare pull does not. Brew packages are not touched: if
# install.sh changed, it says so and you re-run ./install.sh yourself.
set -euo pipefail

# This file is reached through a symlink in $HOME, so resolve it back into the
# repo: home/.config/macarchy/bin/macarchy-update -> four levels up.
REPO="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../../.." && pwd)"
# shellcheck disable=SC1091
. "$REPO/home/.config/macarchy/components.sh"
REPO="$(macarchy_stable_repo "$REPO")"

# A Homebrew install has no .git: `brew upgrade macarchy` replaces the files,
# and this script only relinks. Anything else without .git is a mistake.
BREW_INSTALL=0
if [ ! -e "$REPO/.git" ]; then
  case "$REPO" in
    */opt/macarchy/libexec) BREW_INSTALL=1 ;;
    *)
      echo "macarchy-update: $REPO is not a git checkout" >&2
      exit 1
      ;;
  esac
fi

LABEL=macarchy.update
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/macarchy-update.log"

# --login on|off: install or remove the LaunchAgent. It runs this script with
# --at-login, which waits for the network and posts a notification instead of
# relying on a terminal nobody is watching. Output goes to $LOG.
login_agent() {
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  case "$1" in
    on)
      mkdir -p "$(dirname "$PLIST")" "$(dirname "$LOG")"
      cat >"$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$HOME/.local/bin/macarchy-update</string><string>--at-login</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
PLIST
      # bootstrap also runs it once now (RunAtLoad), a harmless no-op pull
      launchctl bootstrap "gui/$(id -u)" "$PLIST"
      echo "macarchy-update: runs at every login; log at ${LOG/#$HOME/~}"
      ;;
    off)
      rm -f "$PLIST"
      echo "macarchy-update: no longer runs at login"
      ;;
    *)
      echo "macarchy-update: --login takes on or off" >&2
      exit 2
      ;;
  esac
}

notify() { osascript -e "display notification \"$1\" with title \"macarchy\"" >/dev/null 2>&1 || true; }

PULL=1
AT_LOGIN=0
while [ $# -gt 0 ]; do
  arg="$1"
  shift
  case "$arg" in
    --no-pull) PULL=0 ;;
    --login)
      login_agent "${1:-}"
      exit 0
      ;;
    --at-login) AT_LOGIN=1 ;;
    -h | --help)
      sed -n '2,19p' "$0"
      exit 0
      ;;
    *)
      echo "macarchy-update: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

if [ "$BREW_INSTALL" = 1 ] && [ "$PULL" = 1 ]; then
  echo "macarchy-update: installed with Homebrew; relinking only (brew upgrade macarchy fetches new versions)"
  PULL=0
fi

if [ "$AT_LOGIN" = 1 ]; then
  echo "--- $(date '+%F %T')"
  # Wi-Fi is often still joining at login; give it up to a minute.
  [ "$BREW_INSTALL" = 1 ] || for _ in $(seq 30); do
    git -C "$REPO" ls-remote -q origin HEAD >/dev/null 2>&1 && break
    sleep 2
  done
  trap '[ $? = 0 ] || notify "Update failed; see ~/Library/Logs/macarchy-update.log"' EXIT
fi

# 1. Pull
rev() { if [ "$BREW_INSTALL" = 1 ]; then cat "$REPO/version.txt"; else git -C "$REPO" rev-parse HEAD; fi; }
old="$(rev)"
if [ "$PULL" = 1 ]; then
  echo "==> Pulling $REPO"
  git -C "$REPO" pull --ff-only
fi
new="$(rev)"

if [ "$PULL" = 1 ] && [ "$old" = "$new" ]; then
  changed=""
else
  # --no-pull has no range to diff, so treat everything as changed
  if [ "$PULL" = 1 ]; then
    changed="$(git -C "$REPO" diff --name-only "$old" "$new")"
  else
    changed="$(macarchy_repo_files "$REPO")"
  fi
fi

# 2. Link. Only tracked files, so __pycache__ and other local junk under home/
# never lands in $HOME, and only those of the components you picked.
# shellcheck disable=SC1091
. "$REPO/home/.config/macarchy/lib.sh"
echo "==> Linking files into \$HOME (${MACARCHY_COMPONENTS:-$MACARCHY_ALL_COMPONENTS})"
linked=0
while IFS= read -r rel; do
  macarchy_has "$(macarchy_component_of "${rel#home/}")" || continue
  src="$REPO/$rel"
  target="$HOME/${rel#home/}"
  [ "$(readlink "$target" 2>/dev/null)" = "$src" ] && continue
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    echo "  skip: $target is a real file, not a link (move it aside to take the repo version)" >&2
    continue
  fi
  mkdir -p "$(dirname "$target")"
  ln -sfn "$src" "$target"
  echo "  + ${target/#$HOME/~}"
  linked=$((linked + 1))
done < <(macarchy_repo_files "$REPO")

# 3. Prune links to files that no longer exist in the repo
pruned=0
link_dirs=()
while IFS= read -r d; do link_dirs+=("$d"); done < <(macarchy_link_dirs)
while IFS= read -r -d '' link; do
  macarchy_is_our_link "$link" "$REPO" || continue
  [ -e "$link" ] && continue
  rm "$link"
  echo "  - ${link/#$HOME/~}"
  pruned=$((pruned + 1))
done < <(find "${link_dirs[@]}" -maxdepth 6 -type l -print0 2>/dev/null)
echo "  $linked linked, $pruned pruned"

# 4. Reload what changed
touched() { grep -q "^$1" <<<"$changed"; }

echo "==> Reloading"
reloaded=0
if touched home/.config/sketchybar/ && command -v sketchybar >/dev/null 2>&1; then
  sketchybar --reload && echo "  sketchybar" && reloaded=1
fi
if touched home/.config/skhd/ && command -v skhd >/dev/null 2>&1; then
  skhd --reload && echo "  skhd" && reloaded=1
fi
if touched home/.config/yabai/ && command -v yabai >/dev/null 2>&1; then
  yabai --restart-service && echo "  yabai" && reloaded=1
fi
if touched home/.config/borders/ && command -v brew >/dev/null 2>&1; then
  brew services restart borders >/dev/null && echo "  borders" && reloaded=1
fi
if touched home/.config/theme/ && [ -e "$HOME/.config/theme/current" ]; then
  # re-applies the active theme, which reloads the bar, borders, Ghostty, nvim
  "$HOME/.config/theme/bin/theme-set" "$(basename "$(readlink "$HOME/.config/theme/current")")" >/dev/null && echo "  theme" && reloaded=1
fi
if { touched home/.config/macarchy/agent/pyproject.toml || touched home/.config/macarchy/agent/uv.lock; } &&
  [ -x "$HOME/.local/share/macarchy/venv/bin/python" ]; then
  # new ws dependencies; only for installs that already have the agent venv
  "$REPO/home/.config/macarchy/agent/sync-venv" && echo "  ws venv" && reloaded=1
fi
[ "$reloaded" = 1 ] || echo "  nothing to reload"

if touched install.sh; then
  echo
  echo "install.sh changed upstream (new packages or setup steps). Run: $REPO/install.sh"
fi

if [ "$PULL" = 1 ] && [ "$old" = "$new" ]; then
  echo "Already up to date."
else
  echo "Updated ${old:0:7} -> ${new:0:7}"
  if [ "$AT_LOGIN" = 1 ]; then notify "Updated to ${new:0:7}"; fi
fi
