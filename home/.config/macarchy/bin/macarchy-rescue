#!/usr/bin/env bash
# macarchy-rescue -- bring windows that ended up off every display back.
#
# Usage:
#   macarchy-rescue              move each off-screen window to the focused display
#   macarchy-rescue --dry-run    only print what it would move
#   macarchy-rescue --relaunch   also quit and reopen each app whose window
#                                will not move
#
# On macOS 26 and later yabai can miss a display parameter change (a monitor
# unplugged, a resolution switch, wake from sleep), and windows keep frames
# that no longer land on any display. A window whose frame covers less than
# a tenth of its area on any display counts as lost and is moved with
# `yabai -m window <id> --display <focused>`, which needs no scripting
# addition. Minimized and hidden windows are left alone. yabairc runs this
# after display_added, display_removed and system_woke, and macarchy-doctor
# reports the count.
#
# Sometimes the window is past saving: yabai still lists it but every command
# on it fails, and the app keeps that dead window as its only one, so opening
# the app again shows nothing. A plain run names those apps and posts a
# notification (a signal-run rescue has nowhere else to say it); --relaunch
# quits and reopens them, which is the only fix. It never relaunches on its
# own, since quitting a terminal ends its shells. Always exits 0, so a signal
# chain never stops here.

set -uo pipefail

DRY=0 RELAUNCH=0
for a in "$@"; do
  case "$a" in
    -n | --dry-run) DRY=1 ;;
    --relaunch) RELAUNCH=1 ;;
    -h | --help)
      sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "macarchy-rescue: unknown argument: $a" >&2
      exit 2
      ;;
  esac
done

for c in yabai jq; do
  command -v "$c" >/dev/null 2>&1 || {
    echo "macarchy-rescue: $c not found" >&2
    exit 0
  }
done

displays="$(yabai -m query --displays 2>/dev/null)"
windows="$(yabai -m query --windows 2>/dev/null)"
if [ -z "$displays" ] || [ -z "$windows" ]; then
  echo "macarchy-rescue: yabai did not answer" >&2
  exit 0
fi

focused="$(jq -r 'map(select(.["has-focus"])) | .[0].index // empty' <<<"$displays" 2>/dev/null)"
if [ -z "$focused" ]; then
  focused="$(jq -r '.[0].index // empty' <<<"$displays" 2>/dev/null)"
fi
if [ -z "$focused" ]; then
  echo "macarchy-rescue: no displays" >&2
  exit 0
fi

# One line per lost window: id, pid, app, title, frame. Intersection of two frames
# is (overlap in x) * (overlap in y), zero when they do not touch.
lost="$(jq -r --argjson displays "$displays" '
  def inter($a; $b):
    (([$a.x + $a.w, $b.x + $b.w] | min) - ([$a.x, $b.x] | max)) as $w
    | (([$a.y + $a.h, $b.y + $b.h] | min) - ([$a.y, $b.y] | max)) as $h
    | if $w > 0 and $h > 0 then $w * $h else 0 end;
  .[]
  | select((.["is-minimized"] | not) and (.["is-hidden"] | not))
  | select(.frame.w > 0 and .frame.h > 0)
  | . as $win
  | ([$displays[] | inter($win.frame; .frame)] | max) as $seen
  | select($seen < $win.frame.w * $win.frame.h / 10)
  | "\(.id)\t\(.pid)\t\(.app)\t\(.title)\t\(.frame.x | floor),\(.frame.y | floor) \(.frame.w | floor)x\(.frame.h | floor)"
' <<<"$windows" 2>/dev/null)"

if [ -z "$lost" ]; then
  [ "$DRY" = 1 ] && echo "macarchy-rescue: every window is on a display"
  exit 0
fi

# relaunch <pid> <app> -- quit the app politely, wait for it, open it again.
# Found by pid, not name: yabai's app name need not match the bundle's.
relaunch() {
  local pid=$1 app=$2 bin bundle i=0
  bin="$(ps -o comm= -p "$pid" 2>/dev/null)"
  case "$bin" in
    *.app/*) bundle="${bin%%.app/*}.app" ;;
    *)
      echo "macarchy-rescue: no app bundle for $app (pid $pid); quit and reopen it by hand" >&2
      return
      ;;
  esac
  osascript -e "tell application \"$bundle\" to quit" >/dev/null 2>&1
  while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
    sleep 0.5
    i=$((i + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "macarchy-rescue: $app is still running (waiting on a quit dialog?); open it again once it quits" >&2
    return
  fi
  if open "$bundle" >/dev/null 2>&1; then
    echo "relaunched $app"
  else
    echo "macarchy-rescue: $app quit but did not reopen: open \"$bundle\"" >&2
  fi
}

stuck="" # "pid<TAB>app" for each window yabai would not move
while IFS=$'\t' read -r id pid app title frame; do
  [ -n "$id" ] || continue
  if [ "$DRY" = 1 ]; then
    echo "would move $id $app \"$title\" at $frame to display $focused"
  elif yabai -m window "$id" --display "$focused" >/dev/null 2>&1; then
    echo "moved $id $app \"$title\" from $frame to display $focused"
  else
    echo "could not move $id $app \"$title\" (yabai -m window $id --display $focused failed)" >&2
    stuck="$stuck$pid"$'\t'"$app"$'\n'
  fi
done <<<"$lost"

stuck="$(printf '%s' "$stuck" | sort -u)"
[ -n "$stuck" ] || exit 0

if [ "$RELAUNCH" = 1 ]; then
  while IFS=$'\t' read -r pid app; do
    relaunch "$pid" "$app"
  done <<<"$stuck"
  exit 0
fi

names="$(cut -f2 <<<"$stuck" | paste -sd, - | sed 's/,/, /g')"
echo "macarchy-rescue: $names will not come back; relaunch with: macarchy-rescue --relaunch" >&2
# AppleScript string: drop the characters that would end it
msg="$(printf '%s' "yabai cannot move a window of $names. Run: macarchy-rescue --relaunch" | tr -d '"\\')"
osascript -e "display notification \"$msg\" with title \"macarchy\"" >/dev/null 2>&1
exit 0
