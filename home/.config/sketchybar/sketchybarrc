#!/usr/bin/env bash
# Omarchy-style bar: one flat strip in the theme background, monochrome
# foreground glyphs, no pills, no borders. It sits flush with the top edge and
# is exactly as tall as the MacBook notch (32pt), so the notch reads as part of
# the bar instead of hanging below it.
#
# Layout, mirroring Omarchy's waybar:
#   left    Space numbers 1-N (MACARCHY_SPACES; focused = bright, occupied = dim, empty = faint)
#   q       clock, immediately left of the notch (a true center would be under it)
#   e       now-playing, immediately right of the notch, hidden when idle
#   right   caffeine · wifi · volume · cpu+mem · battery — icons only, hover shows the value
#
# BAR_HEIGHT matches the menu-bar/notch strip yabai already excludes, so yabai
# needs no extra top_padding for the bar (see yabairc).

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$PATH"

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# shellcheck disable=SC1091
source "$HOME/.config/macarchy/lib.sh" 2>/dev/null || true
source "$HOME/.config/theme/current/colors.sh" # active theme palette
source "$CONFIG_DIR/colors.sh"

BAR_HEIGHT=32 # notch height on 14"/16" MacBook Pro

##### Bar #####
sketchybar --bar \
  position=top \
  height=$BAR_HEIGHT \
  color="$BAR_BG" \
  margin=0 \
  y_offset=0 \
  blur_radius=0 \
  corner_radius=0 \
  padding_left=6 \
  padding_right=6 \
  display=all

##### Defaults #####
default=(
  padding_left=0
  padding_right=0
  icon.font="$MACARCHY_FONT:Regular:13.0"
  label.font="$MACARCHY_FONT:Regular:12.0"
  icon.color="$WHITE"
  label.color="$WHITE"
  icon.padding_left=7
  icon.padding_right=7
  label.padding_left=0
  label.padding_right=7
  background.drawing=off
)
sketchybar --default "${default[@]}"

##### Native macOS Spaces (tiled by yabai) #####
# yabai emits `yabai_window_change` from the signals defined in ~/.config/yabai/yabairc.
# `space_change` is SketchyBar's own built-in event for native Space switches, and
# is what keeps the bar correct when yabai is not running.
sketchybar --add event yabai_window_change

for sid in $(seq 1 "$MACARCHY_SPACES"); do
  sketchybar --add space space.$sid left \
    --subscribe space.$sid yabai_window_change space_change \
    --set space.$sid \
    associated_space=$sid \
    icon="$sid" \
    icon.padding_left=6 \
    icon.padding_right=6 \
    label.drawing=off \
    click_script="$PLUGIN_DIR/space_click.sh $sid" \
    script="$PLUGIN_DIR/space.sh $sid"
done

##### Clock (left of the notch) #####
sketchybar --add item clock q \
  --set clock \
  icon.drawing=off \
  label.padding_left=7 \
  update_freq=10 \
  script="$PLUGIN_DIR/clock.sh" \
  click_script="$CONFIG_DIR/helpers/open_centered com.apple.iCal ''"

##### Mic and camera in use (right of the notch, like the native menu bar's dots) #####
# plugins/av.sh polls macarchy-avstate (built by ~/.config/macarchy/swift/build) every
# 2s, so any app that opens the mic or camera shows here. While `ws --voice` (alt - w)
# owns the mic the glyph turns red and clicking it is the same as pressing alt - w again.
sketchybar --add event ws_listen
for av in mic cam; do
  sketchybar --add item $av e \
    --set $av \
    drawing=off \
    label.drawing=off \
    update_freq=2 \
    script="$PLUGIN_DIR/av.sh" \
    --subscribe $av ws_listen mouse.clicked mouse.entered mouse.exited
done

##### Now playing (right of the notch) #####
sketchybar --add item media e \
  --set media \
  update_freq=5 \
  script="$PLUGIN_DIR/media.sh" \
  click_script="osascript -e 'tell application \"Spotify\" to playpause' 2>/dev/null || osascript -e 'tell application \"Music\" to playpause' 2>/dev/null"

##### System status (right, icons only; hover reveals the label) #####
# Right items stack right-to-left in add order, so battery is the rightmost.
sketchybar --add item battery right \
  --set battery \
  label.drawing=off \
  update_freq=60 \
  script="$PLUGIN_DIR/battery.sh" \
  click_script="$CONFIG_DIR/helpers/open_centered com.apple.systempreferences 'x-apple.systempreferences:com.apple.Battery-Settings.extension'" \
  --subscribe battery mouse.entered mouse.exited

sketchybar --add item stats right \
  --set stats \
  label.drawing=off \
  update_freq=5 \
  script="$PLUGIN_DIR/stats.sh" \
  click_script="$CONFIG_DIR/helpers/open_centered com.apple.ActivityMonitor ''" \
  --subscribe stats mouse.entered mouse.exited

sketchybar --add item volume right \
  --set volume \
  label.drawing=off \
  script="$PLUGIN_DIR/volume.sh" \
  click_script="osascript -e 'set volume output muted not (output muted of (get volume settings))'; sketchybar --set volume script=\"$PLUGIN_DIR/volume.sh\"" \
  --subscribe volume volume_change mouse.entered mouse.exited

sketchybar --add item wifi right \
  --set wifi \
  label.drawing=off \
  update_freq=30 \
  script="$PLUGIN_DIR/wifi.sh" \
  click_script="$CONFIG_DIR/helpers/open_centered com.apple.systempreferences 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
  --subscribe wifi mouse.entered mouse.exited

# caffeinate -dims toggle. The click is handled by the plugin itself (it
# receives SENDER=mouse.clicked) so start/stop and rendering share one file.
sketchybar --add item caffeine right \
  --set caffeine \
  label.drawing=off \
  update_freq=30 \
  script="$PLUGIN_DIR/caffeine.sh" \
  --subscribe caffeine mouse.clicked mouse.entered mouse.exited

##### Force Initial Update #####
sketchybar --update
