#!/usr/bin/env bash
# Omarchy-style bar: one flat strip in the theme background, monochrome
# foreground glyphs, no pills, no borders. It sits flush with the top edge and
# is exactly as tall as the MacBook notch (32pt), so the notch reads as part of
# the bar instead of hanging below it.
#
# The bar covers the native macOS menu bar. With the menu bar auto-hidden, it
# reveals whenever the pointer reaches the top edge, which is exactly where
# this bar lives, and macOS has no setting for that reveal. So the bar is drawn
# one window level above the menu bar (topmost=on, below) and the menu bar
# slides in underneath it. To reach the native menu bar and its status items:
#   shift + alt - m   hide / show this bar (skhdrc), or click the ⋯ tray item
#   ctrl - F2         macOS "Move focus to menu bar" (ctrl + fn + F2 on the
#                     laptop keyboard); its menus open above the bar
#
# Layout, mirroring Omarchy's waybar:
#   left    Space numbers 1-N (MACARCHY_SPACES; focused = bright, occupied = dim, empty = faint)
#   q       clock, immediately left of the notch (a true center would be under it)
#   e       mic / camera in use, then now-playing, right of the notch, hidden when idle
#   right   MACARCHY_BAR_RIGHT, by default caffeine · wifi · volume · cpu+mem · battery · tray;
#           icons only, hover shows the value (items/<name>.sh, items.d/ for your own)
#
# On a display without a notch, q and e hug the exact midpoint instead, which
# would leave the clock ending at the center rather than sitting on it. So the
# q / e items exist twice: the copies below suffixed ".c" live at `center`.
# plugins/notch.sh shows the q / e set only on displays with a notch and the
# ".c" set everywhere else, at load and whenever displays change.
#
# BAR_HEIGHT matches the menu-bar/notch strip yabai already excludes, so yabai
# needs no extra top_padding for the bar (see yabairc).

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$PATH"

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# shellcheck disable=SC1091
source "$HOME/.config/macarchy/lib.sh" 2>/dev/null || true
source "$HOME/.config/theme/current/colors.sh" # active theme palette
source "$CONFIG_DIR/colors.sh"

BAR_HEIGHT="${MACARCHY_BAR_HEIGHT:-32}" # notch height on 14"/16" MacBook Pro; yabairc reserves the same strip

##### Bar #####
# topmost=on puts the bar at window level 25 (kCGStatusWindowLevel), one above
# the menu bar's 24, so the auto-hidden menu bar reveals underneath an opaque
# bar instead of sliding over it. Drop-down menus open at level 101 and still
# render above the bar. (off is level -20, window is 3: both below the menu bar.)
#
# notch_display_height applies to the notch display only. Its revealed menu
# bar is 33pt tall (measured on a 14" MacBook Pro), 1pt more than the 32pt
# notch, so at 32 a 1pt sliver of the native bar would show under this one.
# External displays have a 30pt menu bar, fully covered at the normal height.
# The extra 1pt overlaps yabai's 32pt reserve, inside the top window padding.
NOTCH_BAR_HEIGHT=$((BAR_HEIGHT > 33 ? BAR_HEIGHT : 33))
sketchybar --bar \
  position=top \
  height=$BAR_HEIGHT \
  color="$BAR_BG" \
  margin=0 \
  y_offset=0 \
  blur_radius=0 \
  corner_radius=0 \
  padding_left=6 \
  padding_right=6 \
  topmost=on \
  notch_display_height=$NOTCH_BAR_HEIGHT \
  display=all

##### Defaults #####
default=(
  padding_left=0
  padding_right=0
  icon.font="$MACARCHY_FONT:Regular:13.0"
  label.font="$MACARCHY_FONT:Regular:12.0"
  icon.color="$WHITE"
  label.color="$WHITE"
  icon.padding_left=7
  icon.padding_right=7
  label.padding_left=0
  label.padding_right=7
  background.drawing=off
)
sketchybar --default "${default[@]}"

##### Native macOS Spaces (tiled by yabai) #####
# yabai emits `yabai_window_change` from the signals defined in ~/.config/yabai/yabairc.
# `space_change` is SketchyBar's own built-in event for native Space switches, and
# is what keeps the bar correct when yabai is not running.
sketchybar --add event yabai_window_change

for sid in $(seq 1 "$MACARCHY_SPACES"); do
  sketchybar --add space space.$sid left \
    --subscribe space.$sid yabai_window_change space_change \
    --set space.$sid \
    associated_space=$sid \
    icon="$sid" \
    icon.padding_left=6 \
    icon.padding_right=6 \
    label.drawing=off \
    click_script="$PLUGIN_DIR/space_click.sh $sid" \
    script="$PLUGIN_DIR/space.sh $sid"
done

##### Clock (left of the notch; centered on displays without one) #####
for item in "clock q" "clock.c center"; do
  # shellcheck disable=SC2086
  set -- $item
  sketchybar --add item "$1" "$2" \
    --set "$1" \
    icon.drawing=off \
    label.padding_left=7 \
    update_freq=10 \
    script="$PLUGIN_DIR/clock.sh" \
    click_script="$CONFIG_DIR/helpers/open_centered com.apple.iCal ''"
done

##### Mic and camera in use (right of the notch, like the native menu bar's dots) #####
# plugins/av.sh polls macarchy-avstate (built by ~/.config/macarchy/swift/build) every
# 2s, so any app that opens the mic or camera shows here. While `ws --voice` (alt - w)
# owns the mic the glyph turns red and clicking it is the same as pressing alt - w again.
sketchybar --add event ws_listen
for av in mic cam; do
  for item in "$av e" "$av.c center"; do
    # shellcheck disable=SC2086
    set -- $item
    sketchybar --add item "$1" "$2" \
      --set "$1" \
      drawing=off \
      label.drawing=off \
      update_freq=2 \
      script="$PLUGIN_DIR/av.sh" \
      --subscribe "$1" ws_listen mouse.clicked mouse.entered mouse.exited
  done
done

##### Now playing (right of the notch) #####
for item in "media e" "media.c center"; do
  # shellcheck disable=SC2086
  set -- $item
  sketchybar --add item "$1" "$2" \
    --set "$1" \
    update_freq=5 \
    script="$PLUGIN_DIR/media.sh" \
    click_script="osascript -e 'tell application \"Spotify\" to playpause' 2>/dev/null || osascript -e 'tell application \"Music\" to playpause' 2>/dev/null"
done

##### Which displays have a notch #####
# Invisible item whose script sorts the q / e items and their ".c" twins onto
# the right displays (see the layout note at the top). Re-run on Space and
# display changes so plugging a monitor in or out is picked up.
sketchybar --add item notch left \
  --set notch \
  drawing=off \
  script="$PLUGIN_DIR/notch.sh" \
  --subscribe notch space_change display_change system_woke

##### System status (right, icons only; hover reveals the label) #####
# One item per file in items/<name>.sh, each defining bar_item_<name>. Your
# own go in ~/.config/sketchybar/items.d/*.sh, sourced after the built-ins so
# a drop-in can also replace one. MACARCHY_BAR_RIGHT picks which are shown and
# in what order, left to right. Right items stack right-to-left in add order,
# so the list is added in reverse: its last name ends up rightmost.
for f in "$CONFIG_DIR"/items/*.sh "$HOME"/.config/sketchybar/items.d/*.sh; do
  # shellcheck disable=SC1090
  [ -f "$f" ] && source "$f"
done

read -ra bar_right <<<"${MACARCHY_BAR_RIGHT:-caffeine wifi volume stats battery tray}"
for ((i = ${#bar_right[@]} - 1; i >= 0; i--)); do
  name="${bar_right[i]}"
  if declare -F "bar_item_$name" >/dev/null; then
    "bar_item_$name"
  else
    echo "sketchybarrc: no bar item '$name' in MACARCHY_BAR_RIGHT (no bar_item_$name function), skipping" >&2
  fi
done

##### Force Initial Update #####
sketchybar --update
